{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(npm run check)",
      "Bash(npm run snap)",
      "Bash(npm run snap:*)",
      "Bash(npm run save:*)",
      "Bash(npm run saves)",
      "Bash(npm run inspect:*)",
      "Bash(npm run assets:*)",
      "Bash(npm run remix:*)",
      "Bash(npm run preview:*)",
      "Bash(npm run undo)",
      "Bash(npm run load:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(tail:*)",
      "Bash(ls:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(rm -rf:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(yarn:*)",
      "Bash(pnpm:*)",
      "Read(./node_modules/**)",
      "Read(./dist/**)",
      "Read(./.env)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/after-edit.mjs\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/statusline.mjs\""
  }
}
