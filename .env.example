# Copy this file to .env (it is never uploaded) and fill in what you have.
# Picture previews with the image AI (gpt-image-2.6). Without it, kids' paper sketches still work.
OPENAI_API_KEY=
# The public link (a Cloudflare tunnel, so friends can play the game from their phones) is on by default.
# Switch it off for this computer:
# PUBLIC_LINK=off
# While the game runs, the setup keeps this computer from falling asleep by itself (a sleeping laptop kills
# the public link). Switch that off:
# KEEP_AWAKE=off
# Optional: a different image model
# IMAGE_MODEL=gpt-image-2.6
# Optional: Poly Pizza API key (downloads work without it)
# POLY_PIZZA_API_KEY=
# Optional: Smithsonian licence checks (the shared DEMO_KEY allows only ~10 checks per hour per network).
# Free key: https://api.data.gov/signup
# SI_API_KEY=
# Optional: GitHub token for KayKit lists on busy school networks (60 requests/hour without one)
# GITHUB_TOKEN=
